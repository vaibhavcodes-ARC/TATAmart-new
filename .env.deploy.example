APP_ENV=production
APP_DEBUG=false
APP_URL=https://api.example.com
FRONTEND_URL=https://example.com
NEXT_PUBLIC_API_URL=https://api.example.com/api

# Generate with: php artisan key:generate --show
APP_KEY=base64:replace-with-generated-app-key

# Generate with: php artisan jwt:secret --show
JWT_SECRET=replace-with-generated-jwt-secret

DB_DATABASE=tatamart_db
DB_USERNAME=tatamart_user
DB_PASSWORD=replace-with-strong-database-password
MARIADB_ROOT_PASSWORD=replace-with-strong-root-password
